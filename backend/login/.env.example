# Copia este archivo a ".env" y ajusta los valores según tu entorno.

# Cadena de conexión a la misma base de datos PostgreSQL que usan
# los servicios "alumnos" y "actividades" (comparten las mismas tablas).
DATABASE_URL="postgresql://postgres:contrasena@localhost:5432/Bookie"

# Debe ser EXACTAMENTE el mismo valor en los 3 servicios (login, alumnos,
# actividades), ya que los tokens se firman aquí y se verifican allá.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Puerto en el que corre este servicio.
PORT=4000
